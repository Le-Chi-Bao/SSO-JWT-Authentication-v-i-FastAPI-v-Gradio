# ============================================================
# DOCKERFILE.auth - Auth Server
# Base image: Python 3.11 slim
# ============================================================

FROM python:3.11-slim

# Thiết lập working directory
WORKDIR /app

# Copy requirements file (nếu có)
# COPY requirements.txt .

# Cài đặt dependencies
RUN pip install --no-cache-dir fastapi uvicorn pyjwt pydantic

# Copy source code
COPY auth_server.py .

# Expose port
EXPOSE 8000

# Chạy service
CMD ["uvicorn", "auth_server:app", "--host", "0.0.0.0", "--port", "8000"]
