# ============================================================
# DOCKERFILE.product - Product Service
# ============================================================

FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn pyjwt pydantic

COPY product_service.py .

EXPOSE 8001

CMD ["uvicorn", "product_service:app", "--host", "0.0.0.0", "--port", "8001"]
